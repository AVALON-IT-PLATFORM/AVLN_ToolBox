<Window x:Class="Avln.ToolBox.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Avln.ToolBox.Models"
        Title="AVLN ToolBox"
        Width="700"
        MinHeight="360"
        MaxHeight="760"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ToolBoxWindowStyle}">
    <Border Margin="18"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource AccentBorderBrush}"
            BorderThickness="4"
            CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="10" Opacity="0.18" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="62" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Height="24" Stretch="Uniform" VerticalAlignment="Center">
                            <Canvas Width="512" Height="114">
                                <Path Fill="{StaticResource AccentBrush}" Data="M135.432 113.32H112.38L102.658 92.5617H33.5048L23.7826 113.32H0.731445L55.3015 0.679688H80.8616L135.432 113.32ZM41.8158 75.0217H94.3473L74.746 33.5067C73.3728 30.4867 68.1624 18.8237 68.1624 18.8237C68.1624 18.8237 62.7903 30.4867 61.4171 33.5067L41.8158 75.0217Z" />
                                <Path Fill="{StaticResource AccentBrush}" Data="M168.615 113.32L115.299 0.679688H139.761L175.514 80.4927C176.338 82.4967 181.865 95.7557 181.865 95.7557C181.865 95.7557 187.392 82.4967 188.216 80.4927L223.969 0.679688H248.431L195.115 113.32H168.615Z" />
                                <Path Fill="{StaticResource AccentBrush}" Data="M366.738 113.32H266.066V0.679688H287.863V94.4927H366.738V113.32Z" />
                                <Path Fill="{StaticResource AccentBrush}" Data="M385.977 113.32V0.679688H420.005L490.256 98.6587C490.256 98.6587 490.256 79.0637 490.256 73.7347V0.679688H511.269V113.32H477.241L406.99 15.6307C406.99 15.6307 406.99 36.3897 406.99 40.2647V113.32H385.977Z" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Margin="12,0,0,0"
                                   Text="ToolBox"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding OpenSettingsCommand}"
                                ToolTip="Настройки">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" Text="&#xE713;" />
                        </Button>
                        <Button Margin="6,0,0,0"
                                Style="{StaticResource IconButtonStyle}"
                                Click="CloseButton_OnClick"
                                ToolTip="Свернуть в трей">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE8BB;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Плагины проектного бюро AVLN" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Margin="0,5,0,0"
                               Text="Установка по версиям Revit"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Margin="0,20,0,10"
                           Text="Версии"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="13"
                           FontWeight="SemiBold" />

                <Grid Grid.Row="2">
                    <Border BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            ClipToBounds="True"
                            Visibility="{Binding HasVersions, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Versions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border MinHeight="64"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,0,0,1">
                                            <Grid Margin="16,0,14,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding Year}"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="1"
                                                           Margin="14,0"
                                                           Text="{Binding StatusText}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:PackageStatus.UpToDate}">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:PackageStatus.UpdateAvailable}">
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:PackageStatus.BrokenInstallation}">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:PackageStatus.Error}">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <Button Grid.Column="2"
                                                        Margin="0,0,8,0"
                                                        Content="{Binding ActionText}"
                                                        Command="{Binding ExecuteActionCommand}"
                                                        Visibility="{Binding HasAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <Button Grid.Column="3"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        Click="MoreButton_OnClick"
                                                        Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        ToolTip="Действия">
                                                    <TextBlock FontSize="20" Text="⋯" />
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Удалить"
                                                                      Foreground="{StaticResource DangerBrush}"
                                                                      Command="{Binding PlacementTarget.DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,24">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Установленные версии Revit не найдены." />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasVersions}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Text" Value="Загрузка данных…" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>